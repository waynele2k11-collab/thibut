# ─────────────────────────────────────────────────────────────────────────────
# Thi Bút — Environment Contract (.env.example)
# Copy to .env.local for local development. Never commit real secrets.
# All HMAC/JWT secrets MUST be >= 32 random characters in production.
# ─────────────────────────────────────────────────────────────────────────────

# Core Application & Database
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/thibut?schema=public"

# Cryptographic Session & Token Secrets (>= 32 chars each in production)
# ADMIN_SESSION_SECRET signs the admin session cookie AND protects the admin's authenticator
# secret in the database. Admin sign-in does not exist (404) without it. Changing it ends every
# admin session and means the authenticator must be set up again with
# `scripts/create-admin.ts --reset-authenticator`. The admin's email, password hash and
# authenticator secret live in the database, never in a setting: see docs/AUTH_MOVE_PLAN.md.
ADMIN_SESSION_SECRET="replace-with-32-plus-char-random-admin-session-secret"
DEVICE_TRUST_SECRET="replace-with-32-plus-char-random-device-trust-secret"
DOWNLOAD_TOKEN_SECRET="replace-with-32-plus-char-random-download-token-secret"
ANON_SESSION_SECRET="replace-with-32-plus-char-random-anon-session-secret"
FULFILLMENT_SECRET_KEY="replace-with-32-plus-char-random-fulfillment-hmac-key"

# Stripe Commerce & Tax
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
STRIPE_TAX_ENABLED="false"

# Printful POD Fulfillment
PRINTFUL_API_KEY="replace-with-printful-private-token"
PRINTFUL_WEBHOOK_SECRET="replace-with-printful-webhook-hmac-secret"

# Private Object Storage (Vercel Blob — required in production for INV-014)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_replace_me"

# Background Jobs (Inngest — INNGEST_SIGNING_KEY required in production)
INNGEST_EVENT_KEY="replace-with-inngest-event-key"
INNGEST_SIGNING_KEY="signkey-prod-replace-with-32-plus-char-inngest-key"

# Transactional Email (Resend)
RESEND_API_KEY="re_replace_me"

# AI Providers (Cultural Intelligence & Non-Text Background Generation)
OPENAI_API_KEY="sk-replace-me"
FAL_KEY="replace-with-fal-api-key"

# Distributed Rate Limiting (Upstash Redis REST — optional in dev, recommended in prod)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional SEO Ping
INDEXNOW_API_KEY=""
