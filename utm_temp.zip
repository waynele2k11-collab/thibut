(function(){
    try {
        var q = window.location.search;
        var m = q.match(/[?&]autodl=([^&]+)/);
        if (!m) return;
        var dlUrl = decodeURIComponent(m[1]);
        // Safety: MUST be relative path starting with / (no absolute URL, no protocol-relative //)
        if (typeof dlUrl !== 'string' || dlUrl.length === 0 || dlUrl.length > 2048) return;
        if (dlUrl.charAt(0) !== '/' || dlUrl.charAt(1) === '/' || dlUrl.charAt(1) === '\\') return;
        // Clean the URL bar so reload doesn't re-trigger
        var clean = window.location.pathname;
        if (window.history && window.history.replaceState) {
            window.history.replaceState({}, '', clean);
        }
        // Trigger download after a short delay (user sees they're back on the page)
        setTimeout(function(){ window.location.href = dlUrl; }, 400);
    } catch(e) {}
})();
</script>
